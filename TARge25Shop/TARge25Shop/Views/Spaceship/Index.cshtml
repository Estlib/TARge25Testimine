@model IEnumerable<TARge25Shop.Models.Spaceship.SpaceshipIndexViewModel>

<div>
    <a asp-action="create" asp-controller="spaceship" id="CreateInIndex" type="submit" class="btn btn-primary">Create</a>
</div>

@{
    short rowNumber = 1;
}


<div class="h1">
    Spaceships
</div>
<form method="get">
    <table id="IndexTable" class="table table-hover">
        <thead>
            <tr>
                <th id="IndexRowNumberColumn" scope="col">Nr</th>
                <th id="IndexNameColumn" scope="col">Name</th>
                <th id="IndexTypeColumn" scope="col">Type</th>
                <th id="IndexBuiltDateColumn" scope="col">Built Date</th>
                <th id="IndexCrewColumn" scope="col">Crew</th>
                <th id="IndexActionsColumn" scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var spaceship in Model)
            {
                <tr>
                    <td id="IndexRowNumberSpaceship">@rowNumber</td>
                    <td id="IndexNameSpaceship">@spaceship.Name</td>
                    <td id="IndexTypeSpaceship">@spaceship.ShipType</td>
                    <td id="IndexBuiltDateSpaceship">@spaceship.CreatedAt</td>
                    <td id="IndexCrewSpaceship">@spaceship.Crew</td>
                    <td id="IndexActionsSpaceship">
                        <a id="IndexSpaceshipDetails" asp-action="details" asp-controller="spaceship" asp-route-id="@spaceship.Id" class="btn btn-primary">Details</a>
                        <a id="IndexSpaceshipUpdate" asp-action="update" asp-controller="spaceship" asp-route-id="@spaceship.Id" class="btn btn-primary">Update</a>
                        <a id="IndexSpaceshipDelete" asp-action="delete" asp-controller="spaceship" asp-route-id="@spaceship.Id" class="btn btn-outline-danger">Delete</a>
                    </td>
                </tr>
                rowNumber += 1;
            }
        </tbody>
    </table>
</form>

